#!/usr/bin/env sh
set -eu

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  echo "Usage: agentharness compose <root/Template.yaml> [Global/Policy.yaml ...]"
  echo "Example: agentharness compose root/Coding-Agent.yaml Global/Security-Baseline.yaml > .agentharness.yaml"
  exit 1
}

[ "$#" -lt 1 ] && usage

case "$1" in
  list)
    find "$REPO_DIR/root" "$REPO_DIR/Global" "$REPO_DIR/community" -name "*.yaml" | sed "s|$REPO_DIR/||"
    ;;
  compose)
    shift
    [ "$#" -lt 1 ] && usage
    echo "# Generated by agentharness CLI"
    for tpl in "$@"; do
      if [ -f "$REPO_DIR/$tpl" ]; then
        echo "---"
        cat "$REPO_DIR/$tpl"
      else
        echo "Error: Template '$tpl' not found." >&2
        exit 1
      fi
    done
    ;;
  *)
    usage
    ;;
esac
